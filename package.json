{
  "name": "wachatchback",
  "private": true,
  "version": "0.1.0",
  "description": "Private, offline viewer for exported WhatsApp chats. Your chats never leave this device.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm icons && tsc -b && vite build",
    "preview": "vite preview",
    "icons": "tsx scripts/generate-icons.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest bench",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "fixtures:gen": "tsx scripts/generate-fixtures.ts",
    "fixtures:update": "tsx scripts/generate-fixtures.ts --update-expected",
    "anonymize": "tsx scripts/anonymize-export.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps:check && pnpm test:coverage && pnpm build && pnpm size && pnpm test:e2e"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-virtual": "3.14.26",
    "@zip.js/zip.js": "2.25.0",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "linkify-it": "6.1.0",
    "ogg-opus-decoder": "1.7.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-node": "0.4.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
